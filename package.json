{
  "name": "@wanghailong0419/dsh-skill-manager",
  "description": "DSH bundle: manage user-level skills from Settings — list all skills with enable/disable switches (disabled skills are excluded from model catalogs)",
  "version": "0.1.4",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/cordis": "^4.0.1",
    "js-yaml": "^4.2.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skill",
    "plugin",
    "bundle",
    "settings"
  ]
}
